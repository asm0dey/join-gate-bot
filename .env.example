# Required
BOT_TOKEN=
# Generate with the keygen entrypoint, e.g.:
#   docker run --rm --entrypoint java ghcr.io/asm0dey/join-gate-bot:latest -cp '/app/lib/*' joinbot.KeygenMainKt
DATA_KEYSET=
# Any secrets you choose; DB_FILE_KEY must not contain a space.
DB_FILE_KEY=
DB_USER_PW=

# Optional (the image sets DB_PATH and WEB_DIR)
MINIAPP_URL=
MINIAPP_PORT=
